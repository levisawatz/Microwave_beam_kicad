(version 1)
(rule "Minimum clearance 1"
	(constraint clearance (min 0.75mm))
	(condition "A.hasNetclass('50 ohm') && (A.Type == 'Zone' || B.Type == 'Zone')")
)


(version 1)
(rule "ant_feed_antipad"
	(constraint clearance (min 0.5mm))
	(condition "A.hasNetclass('50ohm_antenna_feed') && (B.Type == 'Zone')")
)

(version 1)
(rule "Zone to Board Edge Clearance"
	(constraint clearance (min 0.5mm))
	(condition "A.Type == 'Zone' && B.Layer == 'Edge.Cuts'")
)